meta {
  name: Complete Certificate Test Event
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/features/v1/events/{{certificateEventId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}
auth:bearer {
  token: {{rootAccessToken}}
}
body:json {
  {
    "status": "COMPLETED"
  }
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
}
