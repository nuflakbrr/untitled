meta {
  name: Publish Event
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/features/v1/events/{{crudEventId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{rootAccessToken}}
}

body:json {
  {
    "status": "PUBLISHED"
  }
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("publishes event", function() { expect(res.body.data.status).to.equal("PUBLISHED"); });
}

