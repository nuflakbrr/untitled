meta {
  name: List My Registrations
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/features/v1/registrations/me?status=REGISTERED
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pesertaAccessToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("returns participant tickets", function() {
    expect(res.body.data).to.be.an("array").that.is.not.empty;
    expect(res.body.meta.pagination.total).to.be.greaterThan(0);
  });
}

