meta {
  name: Export Event Registrations
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/features/v1/registrations/event/2093030b-adb4-4803-9af2-13a6c1ad8b1a/export
  body: none
  auth: bearer
}

auth:bearer {
  token: {{rootAccessToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("returns xlsx attachment", function() {
    expect(res.headers["content-type"]).to.contain("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    expect(res.headers["content-disposition"]).to.contain(".xlsx");
  });
}

