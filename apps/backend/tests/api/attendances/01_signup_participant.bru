meta {
  name: Sign Up Disposable Participant For Scan Test
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/core/v1/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "attendance.scan.test.{{$randomInt}}@example.com",
    "name": "Attendance Scan Test Participant",
    "password": "securepassword123"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("crudPesertaEmail", res.body.data.user.email);
  }
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("returns created user email", function() { expect(res.body.data.user.email).to.be.a("string"); });
}
