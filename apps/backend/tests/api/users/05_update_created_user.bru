meta {
  name: Update Created User
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/core/v1/users/{{crudUserId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "name": "User API Test Updated"
  }
}
tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("updates user name", function() { expect(res.body.data.name).to.equal("User API Test Updated"); });
}
