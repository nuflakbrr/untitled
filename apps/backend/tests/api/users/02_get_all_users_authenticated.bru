meta {
  name: Get All Users - Authenticated as Superadmin
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/core/v1/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns array of users", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.data.length).to.be.greaterThan(0);
  });

  test("pagination present", function() {
    expect(res.body.meta).to.have.property("pagination");
  });

  test("users have required fields", function() {
    const user = res.body.data[0];
    expect(user).to.have.property("id");
    expect(user).to.have.property("email");
    expect(user).to.have.property("name");
    expect(user).to.have.property("role");
  });
}
