meta {
  name: Membership Test User Sees Own Tenant In my-tenants
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/core/v1/auth/my-tenants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{crudMembershipUserAccessToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("home tenant was auto-populated into user_has_tenants", function() {
    const tenantIds = res.body.data.map(t => t.tenant_id);
    expect(tenantIds).to.include(bru.getEnvVar("tenantFasilkomId"));
  });
}
