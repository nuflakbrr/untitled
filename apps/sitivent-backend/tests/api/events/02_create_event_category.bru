meta {
  name: Create Event Category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/features/v1/event-categories
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{rootAccessToken}}
}

body:json {
  {
    "name": "API Event Category {{$randomInt}}",
    "description": "Created by the local API test suite"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("crudEventCategoryId", res.body.data.id);
  }
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("returns category id", function() { expect(res.body.data.id).to.be.a("string"); });
}

