meta {
  name: List Support Messages As Root
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/features/v1/support-messages?status=PENDING
  body: none
  auth: bearer
}

auth:bearer {
  token: {{rootAccessToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("returns pending messages", function() { expect(res.body.data).to.be.an("array").that.is.not.empty; });
}
