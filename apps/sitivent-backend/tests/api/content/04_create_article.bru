meta {
  name: Create Article
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/features/v1/articles
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{fasilkomAccessToken}}
}

body:json {
  {
    "title": "Fasilkom Raih Penghargaan Nasional {{$randomInt}}",
    "content": "Isi berita lengkap tentang prestasi fakultas.",
    "category_ids": ["{{crudArticleCategoryId}}"]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("crudArticleId", res.body.data.id);
    bru.setEnvVar("crudArticleSlug", res.body.data.slug);
  }
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("returns article id and slug", function() {
    expect(res.body.data.id).to.be.a("string");
    expect(res.body.data.slug).to.be.a("string");
  });
  test("tenant scoped to creator's faculty", function() { expect(res.body.data.tenant_id).to.equal(bru.getEnvVar("tenantFasilkomId")); });
  test("category linked", function() { expect(res.body.data.category_ids).to.include(bru.getEnvVar("crudArticleCategoryId")); });
}
