meta {
  name: Submit Support Message (Public)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/features/v1/support-messages
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "peserta.kendala.{{$randomInt}}@example.com",
    "phone": "081234567890",
    "name": "Peserta Uji Coba",
    "title": "Tidak bisa menyelesaikan pendaftaran",
    "category": "registration",
    "chronology": "Sudah mencoba mendaftar berkali-kali namun selalu gagal di halaman pembayaran."
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("crudSupportMessageId", res.body.data.id);
  }
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("defaults to PENDING", function() { expect(res.body.data.status).to.equal("PENDING"); });
  test("never attaches a user_id from an unauthenticated submission", function() { expect(res.body.data.user_id).to.be.undefined; });
}
