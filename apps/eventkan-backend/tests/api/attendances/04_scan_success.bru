meta {
  name: Scan QR Code Success
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/features/v1/attendances/scan
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{rootAccessToken}}
}

body:json {
  {
    "qr_token": "{{crudQrToken}}",
    "event_id": "2093030b-adb4-4803-9af2-13a6c1ad8b1a"
  }
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("check-in recorded as SUCCESS", function() { expect(res.body.data.status).to.equal("SUCCESS"); });
  test("participant identified", function() { expect(res.body.data.participant_name).to.be.a("string"); });
}
